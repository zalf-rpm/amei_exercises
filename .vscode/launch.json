  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Component Service",
      "type": "debugpy",
      "request": "launch",
      "module": "zalfmas_fbp.run.local_components_service",
      "cwd": "${workspaceFolder}",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "args": ["configs/local_components_service.toml"],
    },
    {
      "name": "Python: Aktuelle Datei",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
    },
  ],
}
